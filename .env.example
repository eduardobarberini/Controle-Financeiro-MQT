# Copie para .env.local e preencha.

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Usadas só pelas Edge Functions (supabase secrets set), nunca no front:
# GURU_API_TOKEN=        # User Token (Admin > Meu Perfil > Tokens API)
# GURU_ACCOUNT_TOKEN=    # Token da conta (Admin > Minha Conta > API), valida webhooks
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=   # token definido ao cadastrar o webhook no Asaas
# META_AD_ACCOUNT_ID=    # act_XXXXXXXX
# META_ACCESS_TOKEN=     # token de usuário do sistema com ads_read
